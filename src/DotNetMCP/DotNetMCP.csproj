<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>

    <!-- Ships as a .NET tool: `dotnet tool install -g DotNetMCP`, or `dnx DotNetMCP` to run
         without installing. The SDK is a runtime prerequisite anyway (Roslyn evaluates project
         files through its out-of-process MSBuild build host), so everyone who can run this
         already has `dotnet`. -->
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>dotnet-mcp</ToolCommandName>
    <PackageId>DotNetMCP</PackageId>
    <Version>0.1.0</Version>
    <Description>An MCP server exposing C# semantic analysis — diagnostics, symbol search, navigation, references, type inspection and rename — built on Roslyn.</Description>
    <PackageTags>mcp;roslyn;csharp;model-context-protocol</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="DotNetMCP.Tests" />
    <None Include="../../README.md" Pack="true" PackagePath="/" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Workspaces" />
    <PackageReference Include="Microsoft.CodeAnalysis.Workspaces.MSBuild" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Features" />
    <PackageReference Include="ICSharpCode.Decompiler" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="Microsoft.Extensions.Logging.Console" />
    <PackageReference Include="ModelContextProtocol" />
  </ItemGroup>

</Project>
